# Caddy in front of lyricad: HTTPS on the host's Tailscale and LAN addresses.
# The DNS record for lyrica.example.net points at the Tailscale address; on the
# LAN, split DNS resolves the same name to the LAN address, so one certificate
# serves both. The certificate comes by DNS-01, because a Tailscale address
# can't be reached for the HTTP challenge. Build Caddy with your DNS provider's
# module (here caddy-dns/cloudflare: `xcaddy build --with github.com/caddy-dns/cloudflare`).
{
	# No plain HTTP listener: the login cookie is Secure.
	auto_https disable_redirects
}

lyrica.example.net {
	# The Tailscale address, then the LAN address.
	bind 100.64.0.10 192.168.1.10

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# Caddy passes the Host header and sets X-Forwarded-For, which lyricad uses
	# for the Origin check and per-address rate limits.
	reverse_proxy 127.0.0.1:7340 {
		# Stream events as they come.
		flush_interval -1
	}
}
