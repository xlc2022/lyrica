#!/bin/bash
# lyrica-nixos-start <module package> <its commit>
# NixOS only: lyricad's ExecStartPre, as root. lyricad runs from the profile
# /nix/var/nix/profiles/lyrica, which an Update or a rollback switches. When
# the module's package changes (nixos-rebuild switch with another flake),
# the profile follows it, after a snapshot if the commit beside the databases
# differs, unless it is an older commit of the running release's history:
# a rebuild never moves her back (an Update leaves the flake's lock behind);
# going back is Roll back. A database the package can't read (SchemaTooNew) gets
# the newest snapshot it can; nothing else restores. See docs/daemon.md, "On NixOS".
set -euo pipefail
. "${LYRICA_UPDATER_LIB:-/usr/local/lib/lyrica-update}/common.sh"

[ $# = 2 ] || die "usage: lyrica-nixos-start <module package> <its commit>"
PKG=$1
mkdir -p "$UPDATE"
exec 9>"$UPDATE/update.lock"
# An Update holds the lock through its switch and start: it chose the profile already.
flock -n 9 || { say "an update is running; starting what it chose"; exit 0; }

# The updater's deploy key and repository, as install.sh makes them on Debian.
KEY=${LYRICA_DEPLOY_KEY:-/etc/lyrica/deploy-key}
if [ ! -f "$KEY" ]; then
  mkdir -p -m 0755 "$(dirname "$KEY")"
  ssh-keygen -q -t ed25519 -N "" -C "lyrica-update@$(uname -n)" -f "$KEY"
  say "add $KEY.pub to the repository as a read-only deploy key"
fi
if [ ! -d "$PREFIX/repo.git" ]; then
  git init -q --bare "$PREFIX/repo.git"
  git --git-dir="$PREFIX/repo.git" remote add origin "${LYRICA_REPO:-git@github.com:xlc2022/lyrica.git}"
fi

[ "$(cat "$UPDATE/module-package" 2>/dev/null || true)" != "$PKG" ] || [ ! -e "$PROFILE" ] || exit 0

# The flake's short commit; a dirty tree's build is named by its store hash.
COMMIT=$2
case "$COMMIT" in *[!0-9a-f]*|"") COMMIT=$(basename "$PKG" | cut -c1-12) ;; esac

# Whether $1 is a strict ancestor of $2 in repo.git; false when either is unknown.
older() {
  local repo=(git --git-dir="$PREFIX/repo.git")
  [ "$1" != "$2" ] || return 1
  "${repo[@]}" cat-file -e "$1^{commit}" 2>/dev/null && "${repo[@]}" cat-file -e "$2^{commit}" 2>/dev/null \
    || GIT_SSH_COMMAND="ssh -i $KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o UserKnownHostsFile=${LYRICA_KNOWN_HOSTS:-/etc/lyrica/known_hosts}" \
      timeout 30 "${repo[@]}" fetch -q origin 2>/dev/null || true
  [ "$("${repo[@]}" rev-parse -q --verify "$1^{commit}" 2>/dev/null)" != "$("${repo[@]}" rev-parse -q --verify "$2^{commit}" 2>/dev/null)" ] \
    && "${repo[@]}" merge-base --is-ancestor "$1" "$2" 2>/dev/null
}
RUNNING=$(current_commit || true)
if [ -n "$RUNNING" ] && [ -e "$PROFILE" ] && [ "$COMMIT" = "$2" ] && older "$COMMIT" "$RUNNING"; then
  say "the module's package (${COMMIT:0:12}) is older than the running release (${RUNNING:0:12}); keeping ${RUNNING:0:12}. Run \`nix flake update lyrica\` to bring the system flake up to date, or use Roll back to go back"
  echo "$PKG" >"$UPDATE/module-package"
  exit 0
fi

INFO=$("$PKG/bin/lyrica" version --json)
mkdir -p "$UPDATE/releases/$COMMIT"
jq --arg c "$COMMIT" --arg at "$(now)" --arg p "$PKG" '{commit: $c, builtAt: $at, version, schema, minReader, path: $p}' <<<"$INFO" \
  >"$UPDATE/releases/$COMMIT/RELEASE.json"
add_release "$COMMIT" "$UPDATE/releases/$COMMIT"
if [ "$(current_commit)" != "$COMMIT" ] && [ -f "$STATE/self.db" ]; then
  say "the module's package changed to ${COMMIT:0:12}: snapshot first"
  "${LYRICA_UPDATER_BIN:-/usr/local/sbin}/lyrica-snapshot" --commit "$(current_commit || true)" >/dev/null
fi
NEEDED=$(releases_json | jq -c '.minReader // {}')
REL=$(release_info "$COMMIT")
if [ -f "$STATE/self.db" ] && ! reads "$REL" "$NEEDED"; then
  SNAP=$(releases_json | jq -r --argjson r "$REL" '
    [(.snapshots // [])[] | select(.kind == "snapshot") | select([("self","user","pool") as $k | ($r.schema[$k] // 0) >= (.minReader[$k] // 0)] | all)]
    | sort_by(.at) | last | .dir // empty')
  if [ -n "$SNAP" ]; then
    say "${COMMIT:0:12} can't read the databases: restoring the snapshot from $(jq -r .at "$SNAP/meta.json")"
    "${LYRICA_UPDATER_BIN:-/usr/local/sbin}/lyrica-restore" "$SNAP" >/dev/null
  else
    say "${COMMIT:0:12} can't read the databases and no snapshot is old enough; lyricad will refuse them (SchemaTooNew)"
  fi
fi
switch_to "$COMMIT"
raise_min_reader "$REL"
echo "$PKG" >"$UPDATE/module-package"
