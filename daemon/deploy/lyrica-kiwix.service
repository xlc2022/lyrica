# The kiwix-serve with her offline copy of Wikipedia, on 127.0.0.1 only.
# daemon/deploy/install.sh installs it as /etc/systemd/system/lyrica-kiwix.service
# when ZIM files are in the ZIM folder; /etc/lyrica/kiwix.env holds that
# folder and the port, and /usr/local/sbin/lyrica-kiwix-start builds the
# library from the files kiwix can open. See docs/guides/wikipedia.md.
[Unit]
Description=kiwix-serve for Lyrica's offline Wikipedia
After=network.target

[Service]
EnvironmentFile=/etc/lyrica/kiwix.env
DynamicUser=yes
RuntimeDirectory=lyrica-kiwix
# Every readable .zim in the folder, so a new dump is served after a restart and a half-downloaded one is skipped.
ExecStart=/usr/local/sbin/lyrica-kiwix-start
Restart=on-failure
RestartSec=10
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
