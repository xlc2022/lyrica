{
  "arch": "ltx2",
  "does": [
    "video",
    "animate"
  ],
  "checkpoint": false,
  "clipType": "ltxv",
  "parts": [
    {
      "role": "diffusion",
      "arch": [
        "ltx2"
      ]
    },
    {
      "role": "text_encoder",
      "slot": "gemma4_12b"
    },
    {
      "role": "vae",
      "slot": null,
      "arch": [
        "ltx2"
      ]
    },
    {
      "role": "vae",
      "slot": "audio",
      "arch": [
        "ltx2"
      ]
    },
    {
      "role": "latent_upscaler",
      "arch": [
        "ltx2"
      ]
    }
  ],
  "references": 0,
  "mask": false,
  "video": {
    "fps": 24,
    "frameStep": 8,
    "frameOffset": 1,
    "sizeStep": 64,
    "maxSeconds": 10,
    "audio": true
  },
  "workflow": {
    "pos": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "$prompt",
        "clip": "$clip"
      }
    },
    "neg": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "$negativePrompt",
        "clip": "$clip"
      }
    },
    "load": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "$image"
      },
      "_if": "image"
    },
    "scale": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "load",
          0
        ],
        "upscale_method": "lanczos",
        "width": "$width",
        "height": "$height",
        "crop": "center"
      },
      "_if": "image"
    },
    "prep": {
      "_if": "image",
      "class_type": "LTXVPreprocess",
      "inputs": {
        "image": [
          "scale",
          0
        ],
        "img_compression": 18
      }
    },
    "cond": {
      "class_type": "LTXVConditioning",
      "inputs": {
        "positive": [
          "pos",
          0
        ],
        "negative": [
          "neg",
          0
        ],
        "frame_rate": "$fps"
      }
    },
    "empty": {
      "class_type": "EmptyLTXVLatentVideo",
      "inputs": {
        "width": "$halfWidth",
        "height": "$halfHeight",
        "length": "$frames",
        "batch_size": 1
      }
    },
    "first": {
      "_if": "image",
      "class_type": "LTXVImgToVideoInplace",
      "inputs": {
        "vae": "$vae",
        "image": [
          "prep",
          0
        ],
        "latent": [
          "empty",
          0
        ],
        "strength": 0.7,
        "bypass": false
      }
    },
    "audio": {
      "class_type": "LTXVEmptyLatentAudio",
      "inputs": {
        "frames_number": "$frames",
        "frame_rate": "$fps",
        "batch_size": 1,
        "audio_vae": "$vae_audio"
      }
    },
    "av": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": {
          "$pick": [
            [
              "first",
              0
            ],
            [
              "empty",
              0
            ]
          ]
        },
        "audio_latent": [
          "audio",
          0
        ]
      }
    },
    "guide": {
      "class_type": "LTXVDualCFGGuider",
      "inputs": {
        "model": "$model",
        "positive": [
          "cond",
          0
        ],
        "negative": [
          "cond",
          1
        ],
        "video_cfg": "$cfg",
        "audio_cfg": "$cfg"
      }
    },
    "noise": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "$seed"
      }
    },
    "sampler": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "$sampler"
      }
    },
    "sigmas": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "$sigmas"
      }
    },
    "sample": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "noise",
          0
        ],
        "guider": [
          "guide",
          0
        ],
        "sampler": [
          "sampler",
          0
        ],
        "sigmas": [
          "sigmas",
          0
        ],
        "latent_image": [
          "av",
          0
        ]
      }
    },
    "split": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": [
          "sample",
          0
        ]
      }
    },
    "upscale": {
      "class_type": "LTXVLatentUpsampler",
      "inputs": {
        "samples": [
          "split",
          0
        ],
        "upscale_model": "$latentUpscaler",
        "vae": "$vae"
      }
    },
    "again": {
      "_if": "image",
      "class_type": "LTXVImgToVideoInplace",
      "inputs": {
        "vae": "$vae",
        "image": [
          "prep",
          0
        ],
        "latent": [
          "upscale",
          0
        ],
        "strength": 1,
        "bypass": false
      }
    },
    "av_full": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": {
          "$pick": [
            [
              "again",
              0
            ],
            [
              "upscale",
              0
            ]
          ]
        },
        "audio_latent": [
          "split",
          1
        ]
      }
    },
    "refine_sigmas": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "$refineSigmas"
      }
    },
    "refine": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "noise",
          0
        ],
        "guider": [
          "guide",
          0
        ],
        "sampler": [
          "sampler",
          0
        ],
        "sigmas": [
          "refine_sigmas",
          0
        ],
        "latent_image": [
          "av_full",
          0
        ]
      }
    },
    "split_full": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": [
          "refine",
          0
        ]
      }
    },
    "decode": {
      "class_type": "VAEDecodeTiled",
      "inputs": {
        "samples": [
          "split_full",
          0
        ],
        "vae": "$vae",
        "tile_size": 512,
        "overlap": 64,
        "temporal_size": 64,
        "temporal_overlap": 16
      }
    },
    "sound": {
      "class_type": "LTXVAudioVAEDecode",
      "inputs": {
        "samples": [
          "split_full",
          1
        ],
        "audio_vae": "$vae_audio"
      }
    },
    "video": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "decode",
          0
        ],
        "fps": "$fps",
        "audio": [
          "sound",
          0
        ]
      }
    },
    "save": {
      "class_type": "SaveVideoWebsocket",
      "inputs": {
        "video": [
          "video",
          0
        ]
      }
    }
  }
}
