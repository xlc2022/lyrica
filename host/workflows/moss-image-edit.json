{
  "arch": "moss-image",
  "does": [
    "edit"
  ],
  "checkpoint": false,
  "clipType": "moss_image",
  "parts": [
    {
      "role": "diffusion",
      "arch": [
        "moss-image"
      ]
    },
    {
      "role": "lora",
      "slot": "edit",
      "arch": [
        "moss-image"
      ]
    },
    {
      "role": "text_encoder",
      "slot": "qwen3.5_9b"
    },
    {
      "role": "vae",
      "arch": [
        "flux2"
      ]
    }
  ],
  "references": 0,
  "mask": false,
  "workflow": {
    "load": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "$image"
      }
    },
    "fit": {
      "class_type": "ImageScaleToTotalPixels",
      "inputs": {
        "image": [
          "load",
          0
        ],
        "upscale_method": "lanczos",
        "megapixels": 1.0,
        "resolution_steps": 16
      }
    },
    "size": {
      "class_type": "GetImageSize",
      "inputs": {
        "image": [
          "fit",
          0
        ]
      }
    },
    "pos": {
      "class_type": "TextEncodeMOSSImageEdit",
      "inputs": {
        "clip": "$clip",
        "prompt": "$prompt",
        "edit_format": "Moss-Image-Edit",
        "images.image_0": [
          "fit",
          0
        ],
        "image_strength": 1,
        "vae": "$vae"
      }
    },
    "neg": {
      "class_type": "TextEncodeMOSSImageEdit",
      "inputs": {
        "clip": "$clip",
        "prompt": "$negativePrompt",
        "edit_format": "Moss-Image-Edit",
        "images.image_0": [
          "fit",
          0
        ],
        "image_strength": 1,
        "vae": "$vae"
      }
    },
    "skip": {
      "class_type": "SkipLayerGuidanceDiTSimple",
      "inputs": {
        "model": "$model",
        "double_layers": "",
        "single_layers": "22",
        "start_percent": 0,
        "end_percent": 1
      }
    },
    "latent": {
      "class_type": "EmptyFlux2LatentImage",
      "inputs": {
        "width": [
          "size",
          0
        ],
        "height": [
          "size",
          1
        ],
        "batch_size": "$count"
      }
    },
    "sample": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "skip",
          0
        ],
        "seed": "$seed",
        "steps": "$steps",
        "cfg": "$cfg",
        "sampler_name": "$sampler",
        "scheduler": "$scheduler",
        "positive": [
          "pos",
          0
        ],
        "negative": [
          "neg",
          0
        ],
        "latent_image": [
          "latent",
          0
        ],
        "denoise": 1
      }
    },
    "decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "sample",
          0
        ],
        "vae": "$vae"
      }
    },
    "save": {
      "class_type": "SaveImageWebsocket",
      "inputs": {
        "images": [
          "decode",
          0
        ]
      }
    }
  }
}
