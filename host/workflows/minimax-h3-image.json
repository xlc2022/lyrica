{
  "arch": "minimax-h3-image",
  "does": [
    "create",
    "edit"
  ],
  "checkpoint": false,
  "clipType": "minimax",
  "parts": [
    {
      "role": "diffusion",
      "arch": [
        "minimax-h3-image"
      ]
    },
    {
      "role": "text_encoder",
      "slot": "qwen3vl_32b"
    },
    {
      "role": "vae",
      "arch": [
        "minimax-h3-image"
      ]
    }
  ],
  "references": 3,
  "mask": false,
  "maxSide": 4096,
  "workflow": {
    "load": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "$image"
      },
      "_if": "image"
    },
    "fit": {
      "class_type": "ImageScaleToTotalPixels",
      "inputs": {
        "image": [
          "load",
          0
        ],
        "upscale_method": "lanczos",
        "megapixels": "$editMegapixels",
        "resolution_steps": 32
      },
      "_if": "image"
    },
    "ref1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "$reference1"
      },
      "_if": "reference1"
    },
    "ref2": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "$reference2"
      },
      "_if": "reference2"
    },
    "ref3": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "$reference3"
      },
      "_if": "reference3"
    },
    "edit": {
      "class_type": "MiniMaxH3ImageConditioning",
      "inputs": {
        "clip": "$clip",
        "vae": "$vae",
        "prompt": "$prompt",
        "width": 0,
        "height": 0,
        "images.image_1": [
          "fit",
          0
        ],
        "images.image_2": [
          "ref1",
          0
        ],
        "images.image_3": [
          "ref2",
          0
        ],
        "images.image_4": [
          "ref3",
          0
        ]
      },
      "_if": "image"
    },
    "create": {
      "class_type": "MiniMaxH3ImageConditioning",
      "inputs": {
        "clip": "$clip",
        "vae": "$vae",
        "prompt": "$prompt",
        "width": "$width",
        "height": "$height",
        "images.image_1": [
          "ref1",
          0
        ],
        "images.image_2": [
          "ref2",
          0
        ],
        "images.image_3": [
          "ref3",
          0
        ]
      },
      "_unless": "image"
    },
    "guide": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": "$model",
        "conditioning": {
          "$pick": [
            [
              "edit",
              0
            ],
            [
              "create",
              0
            ]
          ]
        }
      }
    },
    "noise": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "$seed"
      }
    },
    "sampler": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "$sampler"
      }
    },
    "schedule": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": "$model",
        "scheduler": "$scheduler",
        "steps": "$steps",
        "denoise": 1
      }
    },
    "sample": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "noise",
          0
        ],
        "guider": [
          "guide",
          0
        ],
        "sampler": [
          "sampler",
          0
        ],
        "sigmas": [
          "schedule",
          0
        ],
        "latent_image": {
          "$pick": [
            [
              "edit",
              1
            ],
            [
              "create",
              1
            ]
          ]
        }
      }
    },
    "decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "sample",
          0
        ],
        "vae": "$vae"
      }
    },
    "save": {
      "class_type": "SaveImageWebsocket",
      "inputs": {
        "images": [
          "decode",
          0
        ]
      }
    }
  }
}
