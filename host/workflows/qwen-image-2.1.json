{
  "arch": "qwen-image-2.1",
  "does": [
    "create",
    "edit"
  ],
  "checkpoint": false,
  "clipType": "qwen_image",
  "parts": [
    {
      "role": "diffusion",
      "arch": [
        "qwen-image-2.1"
      ]
    },
    {
      "role": "text_encoder",
      "slot": "qwen3vl_8b"
    },
    {
      "role": "vae",
      "arch": [
        "qwen-image-2.1"
      ]
    }
  ],
  "references": 3,
  "mask": true,
  "workflow": {
    "load": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "$image"
      },
      "_if": "image"
    },
    "seen": {
      "_if": "seen",
      "class_type": "LoadImage",
      "inputs": {
        "image": "$image"
      }
    },
    "ref1": {
      "_if": "reference1",
      "class_type": "LoadImage",
      "inputs": {
        "image": "$reference1"
      }
    },
    "ref2": {
      "_if": "reference2",
      "class_type": "LoadImage",
      "inputs": {
        "image": "$reference2"
      }
    },
    "ref3": {
      "_if": "reference3",
      "class_type": "LoadImage",
      "inputs": {
        "image": "$reference3"
      }
    },
    "mask": {
      "_if": "mask",
      "class_type": "LoadImageMask",
      "inputs": {
        "image": "$mask",
        "channel": "red"
      }
    },
    "grown": {
      "_if": "mask",
      "class_type": "GrowMask",
      "inputs": {
        "mask": [
          "mask",
          0
        ],
        "expand": 24,
        "tapered_corners": true
      }
    },
    "fit": {
      "_if": "mask",
      "class_type": "ImageScaleToTotalPixels",
      "inputs": {
        "image": [
          "load",
          0
        ],
        "upscale_method": "lanczos",
        "megapixels": 1.0,
        "resolution_steps": 16
      }
    },
    "masked": {
      "_if": "mask",
      "class_type": "LanPaint_ImageEncode",
      "inputs": {
        "image": [
          "fit",
          0
        ],
        "vae": "$vae",
        "mask": [
          "grown",
          0
        ]
      }
    },
    "encode": {
      "class_type": "TextEncodeQwenImage21",
      "inputs": {
        "clip": "$clip",
        "prompt": "$prompt",
        "negative_prompt": "$negativePrompt",
        "vae": "$vae",
        "resolution": "$resolution",
        "images.image_1": [
          "seen",
          0
        ],
        "images.image_2": [
          "ref1",
          0
        ],
        "images.image_3": [
          "ref2",
          0
        ],
        "images.image_4": [
          "ref3",
          0
        ]
      }
    },
    "cache": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "model": "$model",
        "device": "auto",
        "dtype": "default"
      }
    },
    "guider": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": [
          "cache",
          0
        ],
        "positive": [
          "encode",
          0
        ],
        "negative": [
          "encode",
          1
        ],
        "cfg": "$cfg"
      }
    },
    "noise": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "$seed"
      }
    },
    "sampler": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "$sampler"
      }
    },
    "sigmas": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "$sigmas"
      }
    },
    "batch": {
      "_if": "image",
      "class_type": "RepeatLatentBatch",
      "inputs": {
        "samples": {
          "$pick": [
            [
              "masked",
              0
            ],
            [
              "encode",
              2
            ]
          ]
        },
        "amount": "$count"
      }
    },
    "canvas": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "$width",
        "height": "$height",
        "batch_size": "$count"
      }
    },
    "sample": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "noise",
          0
        ],
        "guider": [
          "guider",
          0
        ],
        "sampler": [
          "sampler",
          0
        ],
        "sigmas": [
          "sigmas",
          0
        ],
        "latent_image": {
          "$pick": [
            [
              "batch",
              0
            ],
            [
              "canvas",
              0
            ]
          ]
        }
      }
    },
    "inpaint": {
      "_if": "mask",
      "class_type": "LanPaint_SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "noise",
          0
        ],
        "guider": [
          "guider",
          0
        ],
        "sampler": [
          "sampler",
          0
        ],
        "sigmas": [
          "sigmas",
          0
        ],
        "latent_image": [
          "batch",
          0
        ],
        "LanPaint_NumSteps": 5,
        "LanPaint_Lambda": 5.0,
        "LanPaint_StepSize": 0.2,
        "LanPaint_PromptMode": "Image First",
        "LanPaint_Info": ""
      }
    },
    "decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "sample",
          0
        ],
        "vae": "$vae"
      }
    },
    "originals": {
      "_if": "mask",
      "class_type": "RepeatImageBatch",
      "inputs": {
        "image": [
          "load",
          0
        ],
        "amount": "$count"
      }
    },
    "merged": {
      "_if": "mask",
      "class_type": "LanPaint_ImageDecode",
      "inputs": {
        "samples": [
          "inpaint",
          0
        ],
        "vae": "$vae",
        "image": [
          "originals",
          0
        ],
        "mask": [
          "grown",
          0
        ],
        "blend_overlap": 31
      }
    },
    "save": {
      "class_type": "SaveImageWebsocket",
      "inputs": {
        "images": {
          "$pick": [
            [
              "merged",
              0
            ],
            [
              "decode",
              0
            ]
          ]
        }
      }
    }
  }
}
