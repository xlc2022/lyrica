# Written by install.sh; edit and run install.sh again to apply.
HOST_NAME=lyrica-blackwell
# The machine's LAN address. host-api's TLS port is published on it only.
LAN_ADDRESS=192.168.1.20
# The same, in brackets for IPv6.
LAN_BIND=192.168.1.20
# host-api's own bridge and its address on it, named by egress.sh's rules.
EDGE_SUBNET=172.31.236.0/29
HOST_API_IP=172.31.236.2
# The models folder on this machine. Downloads go into its lyrica/ subfolder.
MODELS_DIR=/srv/models
# nvidia or amd; COMPOSE_FILE includes compose.<vendor>.yaml.
GPU_VENDOR=nvidia
# AMD only: the host's render group, for /dev/dri.
RENDER_GID=
COMPOSE_FILE=compose.yaml:compose.nvidia.yaml:compose.lan.yaml
# With Tailscale, add :compose.tailscale.yaml to COMPOSE_FILE and set these.
# The auth key is needed only for the first start.
TS_HOSTNAME=
TS_AUTHKEY=
