# Installed by host/install.sh: keeps host-api without a route out after a
# reboot or a Docker restart (see egress.sh).
[Unit]
Description=Lyrica model host: no outbound connections from host-api
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@HOST_DIR@/egress.sh apply
ExecStop=@HOST_DIR@/egress.sh remove

[Install]
WantedBy=docker.service
