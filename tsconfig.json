{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["core", "host", "extension", "daemon", "bin", "evals", "vitest.config.ts", "vitest.evals.config.ts", "test-env.ts"],
  "exclude": ["**/node_modules"]
}
