{
  "name": "lyrica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["core", "extension", "daemon", "web", "host"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p host",
    "test": "vitest --run",
    "evals": "vitest --run -c vitest.evals.config.ts",
    "build": "npm run build -w @lyrica/web"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "overrides": {
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
