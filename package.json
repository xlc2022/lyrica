{
  "name": "lyrica",
  "private": true,
  "type": "module",
  "workspaces": ["core", "extension", "daemon", "web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest --run",
    "evals": "vitest --run -c vitest.evals.config.ts",
    "build": "npm run build -w @lyrica/web"
  },
  "dependencies": {
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
